<configuration>
  <springProperty name="appName" source="spring.application.name" defaultValue="politico"/>

  <springProfile name="!local">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeContext>true</includeContext>
        <includeMdc>true</includeMdc>
        <customFields>{"app":"politico","env":"${SPRING_PROFILES_ACTIVE:-default}"}</customFields>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

  <springProfile name="local">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="STDOUT"/>
    </root>
  </springProfile>

  <!-- DEBUG only locally; prod stays at INFO so a multi-day backfill can't flood the disk. -->
  <springProfile name="local">
    <logger name="com.politico" level="DEBUG"/>
  </springProfile>
  <springProfile name="!local">
    <logger name="com.politico" level="INFO"/>
  </springProfile>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.hibernate" level="WARN"/>
</configuration>
