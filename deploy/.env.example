# Shared environment for docker-compose (dev + prod)
# Copy this file to `.env` next to the compose file you use and fill in real values.
#
# Dev (repo root docker-compose.yml): defaults resolve to local dev credentials if you
#   do not create a .env — the interpolation `${VAR:-default}` in the compose file
#   keeps `docker compose up` working out-of-the-box.
#
# Prod (deploy/docker-compose.prod.yml): all variables are REQUIRED (no defaults).

# --- Database ---
POSTGRES_DB=riigiluup
POSTGRES_USER=riigiluup
POSTGRES_PASSWORD=riigiluup

# --- Spring / API ---
SPRING_PROFILES_ACTIVE=local

# Comma-separated list of admin emails (Google OAuth).
RIIGILUUP_ADMIN_ALLOWED_EMAILS=you@example.com

# Google OAuth credentials (leave empty locally; required in prod).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Prod-only ---
# Legacy basic-auth admin fallback. Only used by deploy/docker-compose.prod.yml.
RIIGILUUP_ADMIN_USERNAME=
RIIGILUUP_ADMIN_PASSWORD=

# Personal Telegram bot for ops alerts (import failures, api startup). Optional: blank = disabled.
# Create a bot via @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# IndexNow (Bing etc.): must equal the name of frontend/public/<key>.txt. Blank = disabled.
INDEXNOW_KEY=

# --- Umami (self-hosted, cookieless analytics). All four are REQUIRED by docker-compose.prod.yml.
# Create its database once (see deploy/DEPLOY.md, "Umami"):  role `umami` with UMAMI_DB_PASSWORD,
# database `umami` owned by it. UMAMI_APP_SECRET: any long random string (openssl rand -hex 32).
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Umami dashboard login used by the admin panel's read-only analytics proxy, and the website id
# shown in Umami after adding the site (it is also in frontend/index.html's tracker tag).
UMAMI_ADMIN_USERNAME=admin
UMAMI_ADMIN_PASSWORD=
UMAMI_WEBSITE_ID=

# Optional dead-man's switch: backup.sh pings this URL (e.g. healthchecks.io) after a verified dump.
HEALTHCHECK_BACKUP_URL=
