# Shared environment for docker-compose (dev + prod)
# Copy this file to `.env` next to the compose file you use and fill in real values.
#
# Dev (repo root docker-compose.yml): defaults resolve to local dev credentials if you
#   do not create a .env — the interpolation `${VAR:-default}` in the compose file
#   keeps `docker compose up` working out-of-the-box.
#
# Prod (deploy/docker-compose.prod.yml): all variables are REQUIRED (no defaults).

# --- Database ---
POSTGRES_DB=riigiluup
POSTGRES_USER=riigiluup
POSTGRES_PASSWORD=riigiluup

# --- Spring / API ---
SPRING_PROFILES_ACTIVE=local

# Comma-separated list of admin emails (Google OAuth).
RIIGILUUP_ADMIN_ALLOWED_EMAILS=riigiluup@gmail.com

# Google OAuth credentials (leave empty locally; required in prod).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Prod-only ---
# Legacy basic-auth admin fallback. Only used by deploy/docker-compose.prod.yml.
RIIGILUUP_ADMIN_USERNAME=
RIIGILUUP_ADMIN_PASSWORD=
