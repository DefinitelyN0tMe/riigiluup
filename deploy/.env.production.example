# Copy to `.env` on the VPS and fill real values.
POSTGRES_DB=riigiluup
POSTGRES_USER=riigiluup
POSTGRES_PASSWORD=change-me-strong

RIIGILUUP_ADMIN_USERNAME=admin
RIIGILUUP_ADMIN_PASSWORD=change-me-strong

# --- Admin authentication ---
# prod = Google OIDC admin gate (configure GOOGLE_OAUTH_* below). Set to "local" ONLY to force the
# HTTP-Basic fallback (admin / RIIGILUUP_ADMIN_PASSWORD). Do NOT use "local" on a public server:
# with the prod profile the app refuses to start unless OIDC or a non-default password is set.
SPRING_PROFILES_ACTIVE=prod

# Comma-separated Google email allow-list. Only these accounts can reach /api/v1/admin/**.
RIIGILUUP_ADMIN_ALLOWED_EMAILS=you@example.com

# Google OAuth 2.0 credentials.
# Create at: https://console.cloud.google.com/apis/credentials
#   -> "Create credentials" -> "OAuth client ID" -> "Web application"
#   -> Authorized redirect URIs: https://RIIGILUUP_DOMAIN/login/oauth2/code/google
# Leave both blank to fall back to HTTP Basic (safe for staging, not for prod).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Personal Telegram bot for ops alerts (import failures, api startup). Optional: blank = disabled.
# Create a bot via @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# IndexNow (Bing etc.): must equal the name of frontend/public/<key>.txt. Blank = disabled.
INDEXNOW_KEY=

# --- Umami (self-hosted, cookieless analytics). All four are REQUIRED by docker-compose.prod.yml.
# Create its database once (see deploy/DEPLOY.md, "Umami"):  role `umami` with UMAMI_DB_PASSWORD,
# database `umami` owned by it. UMAMI_APP_SECRET: any long random string (openssl rand -hex 32).
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Umami dashboard login used by the admin panel's read-only analytics proxy, and the website id
# shown in Umami after adding the site (it is also in frontend/index.html's tracker tag).
UMAMI_ADMIN_USERNAME=admin
UMAMI_ADMIN_PASSWORD=
UMAMI_WEBSITE_ID=

# Optional dead-man's switch: backup.sh pings this URL (e.g. healthchecks.io) after a verified dump.
HEALTHCHECK_BACKUP_URL=
