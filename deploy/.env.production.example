# Copy to `.env` on the VPS and fill real values.
POSTGRES_DB=politico
POSTGRES_USER=politico
POSTGRES_PASSWORD=change-me-strong

POLITICO_ADMIN_USERNAME=admin
POLITICO_ADMIN_PASSWORD=change-me-strong

# Public host used inside the nginx confs; run scripts/init-server.sh to substitute.
POLITICO_DOMAIN=politico.example
