# Copy to `.env` on the VPS and fill real values.
POSTGRES_DB=politico
POSTGRES_USER=politico
POSTGRES_PASSWORD=change-me-strong

POLITICO_ADMIN_USERNAME=admin
POLITICO_ADMIN_PASSWORD=change-me-strong

# Public host used inside the nginx confs; run scripts/init-server.sh to substitute.
POLITICO_DOMAIN=politico.example

# --- Admin authentication ---
# prod = Google OIDC admin gate (configure GOOGLE_OAUTH_* below). Set to "local" ONLY to force the
# HTTP-Basic fallback (admin / POLITICO_ADMIN_PASSWORD). Do NOT use "local" on a public server:
# with the prod profile the app refuses to start unless OIDC or a non-default password is set.
SPRING_PROFILES_ACTIVE=prod

# Comma-separated Google email allow-list. Only these accounts can reach /api/v1/admin/**.
POLITICO_ADMIN_ALLOWED_EMAILS=riigiluup@gmail.com

# Google OAuth 2.0 credentials.
# Create at: https://console.cloud.google.com/apis/credentials
#   -> "Create credentials" -> "OAuth client ID" -> "Web application"
#   -> Authorized redirect URIs: https://POLITICO_DOMAIN/login/oauth2/code/google
# Leave both blank to fall back to HTTP Basic (safe for staging, not for prod).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
